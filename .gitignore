.venv/
__pycache__/
*.pyc

# Archivos que suben los usuarios: son datos, no codigo, y no deben ir al repositorio.
# Conservo la carpeta con .gitkeep para que exista al clonar el proyecto.
config/uploads/*
!config/uploads/.gitkeep

# Dependencias de Composer (se instalan con: composer install)
/vendor/
