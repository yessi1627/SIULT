.venv/
__pycache__/
*.pyc

# Archivos que suben los usuarios: son datos, no codigo, y no deben ir al repositorio.
config/uploads/*
!config/uploads/.gitkeep

# Dependencias de Composer (se instalan con: composer install)
/vendor/

# Dependencias de los microservicios Node (se instalan con: cd servicios && npm install)
node_modules/

# Cache de PHPUnit y reportes de las pruebas BDD
.phpunit.cache/
servicios/reportes/
